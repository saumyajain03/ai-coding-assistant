# ==============================================================================
# PROJECT SENTINELFORGE: ENVIRONMENT CONFIGURATION
# ==============================================================================
# All settings are dynamically read by src/config.py via Pydantic Settings.
# Copy this file to .env and adjust values as needed for your environment.

# --- SERVER & RUNTIME ---
APP_ENV=development                    # development | staging | production
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# --- DIRECTORIES & WORKSPACE JAIL ---
# All sandboxed agent operations and repository modifications are jailed to WORKSPACE_ROOT
DATA_DIR=./data
WORKSPACE_ROOT=./data/workspace
VECTOR_DB_PATH=./data/chroma
SCRATCH_DIR=./data/scratch

# --- LOCAL RAG & EMBEDDINGS (100% Zero-Cost Local Default) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2  # SentenceTransformers model (runs locally on CPU)
EMBEDDING_DEVICE=cpu                   # cpu | mps | cuda
OFFLINE_MODE=false                     # If true, blocks all outbound network calls for embeddings
CHUNK_SIZE=500                         # Token/character target size per chunk
CHUNK_OVERLAP=50                       # Overlap between consecutive chunks
TOP_K_RETRIEVAL=5                      # Default number of retrieved context citations

# --- PDF PROCESSING & LAZY MULTIMODAL SETTINGS ---
MAX_PDF_SIZE_MB=20                     # Enforce Render-friendly PDF file size limit
MAX_PDF_PAGES=100                      # Enforce max page count per PDF upload
PDF_PAGE_TEXT_MIN_CHARS=50             # Threshold below which a page is tested for scanned content
PDF_SCANNED_MAX_CHARS=40               # Threshold identifying lack of selectable text
PDF_VISUAL_MIN_IMAGES=1                # Minimum images for visual-heavy page classification
ENABLE_OCR=true                        # Enable lazy on-demand local OCR for scanned pages
MAX_OCR_PAGES_PER_REQUEST=3            # Cap on-demand OCR processing per query
OCR_TIMEOUT_SEC=10                     # Timeout for local tesseract execution
ENABLE_VISUAL_RAG=false                # Disabled by default to respect Render Free 512MB RAM constraint
ENABLE_LAZY_VISUAL_PROCESSING=true     # On-demand visual region inspection
VISUAL_PROCESSING_MODE=on_demand       # on_demand | precompute | disabled
MAX_VISUAL_PAGES_PER_REQUEST=2         # Max visual pages processed per query
MAX_RENDER_IMAGE_RES=150               # Bounded DPI resolution for image rendering
MAX_VISUAL_REGIONS_PER_PAGE=5          # Cap visual regions detected per page
VISUAL_TIMEOUT_SEC=10                  # Timeout for visual processing


# --- LLM INFERENCE (Zero-Cost Compliance & Multi-Provider Support) ---
# Supported providers:
#   - ollama: 100% local open-source inference (e.g., qwen2.5-coder:1.5b, llama3.2:1b)
#   - groq_free: Free-tier ultra-fast cloud inference (requires free Groq API key)
#   - hf_free: Hugging Face free serverless inference API
#   - openai_compatible: Any local or remote OpenAI-compatible endpoint (vLLM, llama.cpp server)
#   - synthetic_mock: Zero-dependency deterministic rule-based agent (for offline CI/CD & testing)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434

# Optional API Keys (Leave blank if using ollama or synthetic_mock)
LLM_API_KEY=
LLM_API_BASE_URL=

# --- SANDBOX SECURITY & RESOURCE LIMITS ---
SANDBOX_TIMEOUT_SEC=15                 # Hard execution timeout per test/command
SANDBOX_MAX_MEMORY_MB=256              # Memory limit per command via RLIMIT_AS (in MB)
SANDBOX_MAX_NPROC=10                   # Process limit per command via RLIMIT_NPROC (fork bomb defense)
SANDBOX_MAX_OUTPUT_BYTES=65536         # 64 KB output buffer cap to prevent DoS
ALLOW_NETWORK_DEFAULT=false            # Sandboxed commands have NO network access by default
REQUIRE_HUMAN_APPROVAL_FOR_PATCH=true  # Mandatory HITL gate: patches are never applied silently

# --- API SECURITY & RATE LIMITS ---
RATE_LIMIT_PER_MINUTE=60               # Maximum requests per minute per IP
MAX_UPLOAD_SIZE_MB=10                  # Maximum single file upload size (in MB)
CORS_ORIGINS=["*"]                     # JSON-formatted allowed origins list
